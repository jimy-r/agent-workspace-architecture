{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.py"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/security/check_bash_command.py"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-format.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py"],
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  }
}
